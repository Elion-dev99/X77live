{
  "name": "x77live-online-tracker",
  "version": "1.0.0",
  "description": "大阪店LIVE在籍メンバーのオンライン稼働状況を追跡し、Discordに定期通知するBot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "sandbox": "BOT_MODE=sandbox node src/index.js",
    "dev:sandbox": "BOT_MODE=sandbox node --watch src/index.js",
    "register-commands": "node scripts/register-commands.js",
    "register-commands:sandbox": "BOT_MODE=sandbox node scripts/register-commands.js",
    "invite": "node scripts/invite-url.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "discord",
    "bot",
    "x77live",
    "osaka",
    "online-tracker"
  ],
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  }
}
