# Discord Developer Portal で作成した Bot のトークン（必須）
DISCORD_TOKEN=your_bot_token_here

# Application ID（Client ID）— スラッシュコマンド登録に使用（必須）
DISCORD_CLIENT_ID=your_client_id_here

# 推奨: サーバーID — スラッシュコマンドを即時反映
DISCORD_GUILD_ID=your_guild_id_here

# Railway Volume のマウント先（Volume を /data に付けた場合）
# DATA_DIR=/data

# --- 監視設定 ---

# 通知先チャンネルID
# NOTIFY_CHANNEL_ID=1234567890123456789

# 定期通知間隔（分）。デフォルト 10
# NOTIFY_INTERVAL_MINUTES=10

# x77.jp 監視間隔（分）。デフォルト 2
# POLL_INTERVAL_MINUTES=2

# 店舗名。デフォルト「大阪店」
# STORE_NAME=大阪店

# 男子学園 shop_id。大阪店 = 4
# SHOP_ID=4

# 管理者ロールID（カンマ区切りで複数可）
# ADMIN_ROLE_IDS=1234567890123456789

# 定期通知を有効にするか（true/false）。デフォルト true
# NOTIFY_ENABLED=true

# 定期通知時にメンションするロールID
# MENTION_ROLE_ID=

# カスタマイズコマンド用の管理パスワード（必須）
ADMIN_PASSWORD=your_admin_password_here

# 管理者 DM 通知先（Discord ユーザー ID。取得失敗アラート等）
# ADMIN_USER_ID=879683856121364490

# 認証セッション有効時間（時間）。デフォルト 8
# AUTH_SESSION_HOURS=8

# x77.jp 監視間隔（分）。デフォルト 2
# POLL_INTERVAL_MINUTES=2

# 取得失敗アラート（管理者 DM）
# SCRAPE_ALERT_THRESHOLD=3
# SCRAPE_ALERT_ENABLED=true

# 営業中レポート自動バックアップ
# REPORT_BACKUP_INTERVAL_HOURS=3
# REPORT_BACKUP_ENABLED=true
# REPORT_BACKUP_NOTIFY_ADMIN=true

# 営業時間
# BUSINESS_HOURS_OPEN=13:00
# BUSINESS_HOURS_CLOSE=01:00
# MONITOR_BUSINESS_HOURS_ONLY=true
# DAILY_SUMMARY_AT=01:00
