# サンドボックス用 — cp sandbox.env.example .env.sandbox
# ⚠️ 本番 Bot (X77live) とは別の Discord Application / テスト用サーバー推奨

BOT_MODE=sandbox

# テスト用 Bot のトークン（本番 DISCORD_TOKEN と別のもの）
DISCORD_TOKEN=your_sandbox_bot_token_here
DISCORD_CLIENT_ID=your_sandbox_client_id_here

# テスト用 Discord サーバー（幹部サーバーとは別が安全）
DISCORD_GUILD_ID=your_test_guild_id_here
NOTIFY_CHANNEL_ID=your_test_channel_id_here

# サンドボックス専用データ（本番 data/ と分離）
DATA_DIR=data-sandbox

# サンドボックス既定: 定期通知 OFF（テスト時だけ true に）
NOTIFY_ENABLED=false

# ステータス変更 ping も既定 OFF
PING_ON_STATUS_CHANGE=false

ADMIN_PASSWORD=sandbox-test-password
SHOP_ID=4
STORE_NAME=大阪店

# 監視負荷を下げる（任意）
POLL_INTERVAL_MINUTES=5
NOTIFY_INTERVAL_MINUTES=30
