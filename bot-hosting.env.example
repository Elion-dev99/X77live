# Bot-Hosting.net → Startup → Env Variables にコピーしてください
# Secret にするもの: DISCORD_TOKEN, ADMIN_PASSWORD

DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=1542843731219185704
DISCORD_GUILD_ID=1533753990196625461
NOTIFY_CHANNEL_ID=1542848670221860884
SHOP_ID=4
STORE_NAME=大阪店
ADMIN_PASSWORD=your_admin_password_here
# 既存パスワードを上書きしたいときだけ一時的に true（再起動後に削除）
# ADMIN_PASSWORD_RESET=true
DATA_DIR=data

# 管理者への DM 通知先（あなたの Discord ユーザー ID）
# 開発者モード ON → 自分のアイコン右クリック → IDをコピー
ADMIN_USER_ID=879683856121364490

# 監視・通知
POLL_INTERVAL_MINUTES=2
NOTIFY_INTERVAL_MINUTES=10
NOTIFY_ENABLED=true
AUTH_SESSION_HOURS=8

# 営業時間・日次サマリー
BUSINESS_HOURS_OPEN=13:00
BUSINESS_HOURS_CLOSE=01:00
DAILY_SUMMARY_AT=01:00

# 取得失敗アラート（管理者 DM）
SCRAPE_ALERT_THRESHOLD=3
SCRAPE_ALERT_ENABLED=true

# 営業中レポート自動バックアップ（管理者 DM で完了通知）
REPORT_BACKUP_INTERVAL_HOURS=3
REPORT_BACKUP_ENABLED=true
REPORT_BACKUP_NOTIFY_ADMIN=true

# config.json 自動バックアップ
CONFIG_BACKUP_INTERVAL_HOURS=3
CONFIG_BACKUP_ENABLED=true

# Bot 死活監視（管理者 DM）
BOT_LIVENESS_MINUTES=10
BOT_LIVENESS_ENABLED=true

# 週次レポート（日曜営業終了後 = 月 01:00 JST）
WEEKLY_SUMMARY_ENABLED=true

# シフト照合（EX API / dgdgdg フォールバック）
SHIFT_CHECK_ENABLED=true
SHIFT_ALERT_ENABLED=true
SHIFT_GRACE_MINUTES=15
# EX リポジトリ連携: デフォルトで EX API を使用（無効化する場合 false）
# EX_SHIFT_ENABLED=false
# カスタム URL に差し替える場合（省略時は EX 本番 API）
# EX_SHIFT_JSON_URL=https://ex-shift.elion-dev08.workers.dev/api/shop/schedule?shop_id=4
